# Copy to functions/.env.<your-firebase-project-id> (gitignored). Non-secret settings only.
# Secrets (access token, app secret, verify token) go in Firebase Secret Manager, never in files.
WHATSAPP_PHONE_NUMBER_ID=
# Comma-separated Google accounts allowed to sign in
ALLOWED_EMAILS=
# Phase 5 Google Calendar sync (docs/APPOINTMENTS.md). scripts/deploy-appointments.sh writes these: use its "sync on|off" stages.
GCAL_SYNC=off
GCAL_CALENDAR_ID=
GCAL_SERVICE_ACCOUNT=
