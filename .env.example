# Copy to .env for local dev. NEVER commit real values. On the host, set these
# in the platform's secret/environment-variable settings.

PORT=3000
DATABASE_URL=postgres://user:pass@localhost:5432/leados
# Set to "true" when the host's Postgres requires SSL (most managed hosts do).
DATABASE_SSL=false

# Login for the web UI (HTTP basic auth). Username is fixed: admin
ADMIN_PASSWORD=change-me

# --- Meta WhatsApp Cloud API (server-side only) ---
# Meta app > WhatsApp > API Setup > Phone number ID
WHATSAPP_PHONE_NUMBER_ID=
# Long-lived System User token with whatsapp_business_messaging permission
WHATSAPP_ACCESS_TOKEN=
# Meta app > App settings > Basic > App secret (verifies webhook signatures)
WHATSAPP_APP_SECRET=
# Any random string you invent; must match what you type into Meta's webhook setup
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_API_VERSION=v21.0
WHATSAPP_TEMPLATE_NAME=elite_kitchens_new_lead
WHATSAPP_TEMPLATE_LANG=en
