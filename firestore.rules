rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Only signed-in staff (custom claim set by the claimAccess function) may READ.
    // Nobody can write from a browser: every write goes through Cloud Functions (Admin SDK).
    match /{document=**} {
      allow read: if request.auth != null && request.auth.token.staff == true;
      allow write: if false;
    }
  }
}
